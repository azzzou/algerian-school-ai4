# =============================================================================
# Meta Messenger Gateway (.env.example)
# Copy to `.env` and fill in real values.
# =============================================================================

# Facebook App Secret - used to verify X-Hub-Signature-256 on webhooks.
MESSENGER_APP_SECRET=
# Token you set in the Facebook App webhook configuration (any string).
MESSENGER_VERIFY_TOKEN=
# Page-scoped access token for your Facebook Page.
MESSENGER_PAGE_ACCESS_TOKEN=

# URL of the AI Engine service (docker-compose service name by default).
AI_ENGINE_URL=http://ai_engine:8000
