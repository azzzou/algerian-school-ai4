# Never ship environment/secret files
.env
.env.*
!.env.example

# Version control / build tooling
.git
.gitignore
.vscode
.idea
*.md
render.yaml
render.yml

# PHP / Composer (rebuilt inside the image)
/vendor/
node_modules/
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
public/hot
public/storage

# Backend / runtime databases (source-controlled database.sqlite is kept)
leads.db
*.leads.db

# Archives / logs
*.zip
*.tar.gz
*.log

# OS
.DS_Store
Thumbs.db