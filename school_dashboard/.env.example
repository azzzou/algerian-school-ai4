APP_NAME="Algerian School Support"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=${APP_URL}

LOG_CHANNEL=stack

# SQLite for Railway (simplest setup)
DB_CONNECTION=sqlite
DB_DATABASE=${RAILWAY_VOLUMEMount_PATH}/database.sqlite

# AI Leads Database (separate SQLite in same volume)
DB_LEADS_DATABASE=${RAILWAY_VOLUMEMount_PATH}/leads.db

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# AI Engine API Key
AI_API_KEY=sk-algerian-school-ai-2026-production-key

# ---------------------------------------------------------------
# Facebook Messenger Configuration
# ---------------------------------------------------------------
MESSENGER_VERIFY_TOKEN=Azzou123
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_AI_SERVICE_URL=http://localhost:8000
MESSENGER_PAGE_ID=
MESSENGER_CONTACT_PHONE="+213 XXX XX XX XX"
MESSENGER_REPLY_LANGUAGE=darija
MESSENGER_SCHOOL_NAME=مدرستنا
