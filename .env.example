# =============================================================================
#  Algerian School Support - Root .env.example
#  Copy to `.env` at the project root before running `docker compose up`.
#  This is the single env file consumed by all containerised services.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
SERVER_MODE=dev
LOG_LEVEL=INFO

# --- Google Gemini (AI Engine) ----------------------------------------------
# REQUIRED. Legacy "AIza..." or new "AQ...." signed keys both supported.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024

# --- Meta Messenger Webhook (Gateway) ---------------------------------------
# REQUIRED for the gateway.
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Redis / Queue ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Shared database (dashboard) --------------------------------------------
# Set DB_PASSWORD in your deployment environment (e.g. Railway Variable Dashboard).
