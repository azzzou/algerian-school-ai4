# =============================================================================
#  AI ENGINE - Environment Configuration (.env.example)
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit the real `.env` file to version control.
#
#  This file documents every sensitive/runtime variable used by the Algerian
#  School Support crew. Set `SERVER_MODE=production` for production runs.
# =============================================================================

# --- Runtime mode ------------------------------------------------------------
# dev  -> verbose logging, no external integrations
# prod -> hardened config, structured JSON output, remote logging
SERVER_MODE=dev

# --- Google Gemini (AI Engine) ----------------------------------------------
# REQUIRED. Your Google AI Studio / Vertex API key.
# Format: legacy "AIza..." or new "AQ...." signed keys.
GOOGLE_API_KEY=

# Gemini model identifier. Defaults to a fast, widely-available model.
GEMINI_MODEL=gemini-3.6-flash

# LLM sampling temperature (0.0 = deterministic, 1.0 = creative).
GEMINI_TEMPERATURE=0.7

# Max tokens for the reply (protects cost/latency on the gateway).
GEMINI_MAX_TOKENS=1024

# --- CrewAI ------------------------------------------------------------------
# Verbose agent logging. Keep `false` in prod to reduce log noise / cost.
CREWAI_VERBOSE=false
# Enable CrewAI tracing collection (uses external tracing backend if installed).
CREWAI_TRACING_ENABLED=false

# --- App info (used in logs / tracing) ----------------------------------------
APP_NAME=algerian-school-ai-engine
APP_ENV=development
LOG_LEVEL=INFO

# =============================================================================
# The following variables are consumed by the FastAPI Gateway (meta_gateway),
# listed here so the whole stack shares one env file when dockerised.
# =============================================================================

# --- Meta Messenger Webhook ---------------------------------------------------
# REQUIRED for the gateway. Facebook App Secret (used to verify X-Hub-Signature).
MESSENGER_APP_SECRET=
# Arbitrary token you configure in the Facebook App webhook settings.
MESSENGER_VERIFY_TOKEN=
# Page-scoped access token granted by the Facebook App for your Page.
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Redis (caching / queue) ---------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL (school dashboard) --------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=school
DB_USERNAME=postgres
# Set DB_PASSWORD in your deployment environment (e.g. Railway Variable Dashboard).
