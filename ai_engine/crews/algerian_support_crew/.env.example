# =============================================================================
#  Algerian Support Crew - Environment (.env.example)
#  The authoritative env file lives at the ai_engine root; this one documents
#  the variables scoped to the crew and its local test harness.
# =============================================================================

# REQUIRED: Google Gemini API key (legacy "AIza..." or new "AQ...." signed key).
GOOGLE_API_KEY=

# Gemini model for the support agent.
GEMINI_MODEL=gemini-3.6-flash

# Runtime mode: dev | prod
SERVER_MODE=dev
